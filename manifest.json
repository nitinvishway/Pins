{
  "manifest_version": 3,
  "name": "PinVault",
  "version": "1.0",
  "description": "Bulk download pins from any Pinterest board directly from card hovers.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": [
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://i.pinimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.pinterest.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
